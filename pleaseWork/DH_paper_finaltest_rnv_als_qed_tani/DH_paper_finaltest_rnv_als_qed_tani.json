{
    "run_type": "staged_learning",
    "device": "cuda",
    "use_cuda": true,
    "tb_logdir": "DH_paper_finaltest_rnv_als_qed_tani_tb_logs",
    "json_out_config": "DH_paper_finaltest_rnv_als_qed_tani.json",
    "seed": null,
    "parameters": {
        "prior_file": "priors/reinvent.prior",
        "agent_file": "priors/reinvent.prior",
        "summary_csv_prefix": "DH_paper_finaltest_rnv_als_qed_tani",
        "use_checkpoint": true,
        "purge_memories": false,
        "smiles_file": null,
        "sample_strategy": "multinomial",
        "distance_threshold": 99999,
        "batch_size": 128,
        "randomize_smiles": true,
        "unique_sequences": true,
        "temperature": 1.0,
        "tb_isim": true
    },
    "scoring": null,
    "scheduler": null,
    "responder": null,
    "filter": null,
    "stage": [
        {
            "max_steps": 100,
            "max_score": 0.8,
            "chkpt_file": "DH_paper_finaltest_rnv_als_qed_tani.chkpt",
            "termination": "simple",
            "min_steps": 50,
            "scoring": {
                "type": "arithmetic_mean",
                "component": [
                    {
                        "custom_alerts": {
                            "endpoint": [
                                {
                                    "name": "Unwanted SMARTS",
                                    "params": {
                                        "smarts": [
                                            "[*;r8]",
                                            "[*;r9]",
                                            "[*;r10]",
                                            "[*;r11]",
                                            "[*;r12]",
                                            "[*;r13]",
                                            "[*;r14]",
                                            "[*;r15]",
                                            "[*;r16]",
                                            "[*;r17]",
                                            "[#8][#8]",
                                            "[#6;+]",
                                            "[#16][#16]",
                                            "[#7;!n][S;!$(S(=O)=O)]",
                                            "[#7;!n][#7;!n]",
                                            "C#C",
                                            "C(=[O,S])[O,S]",
                                            "[#7;!n][C;!$(C(=[O,N])[N,O])][#16;!s]",
                                            "[#7;!n][C;!$(C(=[O,N])[N,O])][#7;!n]",
                                            "[#7;!n][C;!$(C(=[O,N])[N,O])][#8;!o]",
                                            "[#8;!o][C;!$(C(=[O,N])[N,O])][#16;!s]",
                                            "[#8;!o][C;!$(C(=[O,N])[N,O])][#8;!o]",
                                            "[#16;!s][C;!$(C(=[O,N])[N,O])][#16;!s]"
                                        ]
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "QED": {
                            "endpoint": [
                                {
                                    "name": "QED",
                                    "weight": 0.3
                                }
                            ]
                        }
                    },
                    {
                        "TanimotoDistance": {
                            "endpoint": [
                                {
                                    "name": "TanimotoDistance",
                                    "weight": 0.3,
                                    "params": {
                                        "smiles": [
                                            "C[C@@H](c1c(cc(cc1)OC)Cl)NC(=O)[C@@H]1C[C@H](CN1C(=O)CNC(=O)c1nc2c(cc1)cc(cc2)F)O"
                                        ],
                                        "radius": 3,
                                        "use_counts": true,
                                        "use_features": true
                                    }
                                }
                            ]
                        }
                    }
                ],
                "filename": null
            },
            "diversity_filter": null
        }
    ],
    "learning_strategy": {
        "type": "dap",
        "sigma": 128,
        "rate": 0.0001
    },
    "diversity_filter": null,
    "inception": null
}